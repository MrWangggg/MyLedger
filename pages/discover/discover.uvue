		color: #2F6BFF;
	}

	/* 预算 */
	.budget-line {
		flex-direction: row;
		align-items: flex-end;
		margin-top: 24rpx;
	}
	.budget-big {
		font-size: 52rpx;
		font-weight: bold;
		color: #1F2937;
	}
	.budget-state {
		margin-left: 16rpx;
