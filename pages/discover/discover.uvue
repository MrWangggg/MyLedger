<template>
	<scroll-view class="page" scroll-y>
		<!-- 月度结余卡 -->
		<view class="hero-card">
			<text class="hero-label">{{ monthLabel }}结余</text>
			<text class="hero-value">¥{{ fmtMoney(stat.balance) }}</text>
			<view class="hero-row">
				<view class="hero-item">
					<text class="hero-sub-label">收入</text>
					<text class="hero-sub-value in-text">¥{{ fmtMoney(stat.income) }}</text>
				</view>
				<view class="hero-divider"></view>
				<view class="hero-item">
					<text class="hero-sub-label">支出</text>
					<text class="hero-sub-value">¥{{ fmtMoney(stat.expense) }}</text>
				</view>
			</view>
		</view>

		<!-- 本月预算卡 -->
		<view class="card">
			<view class="card-head">
				<text class="card-title">本月预算</text>
				<text class="card-action" @click="editBudget">{{ budget > 0 ? '修改' : '设置' }}</text>
			</view>
			<template v-if="budget > 0">
				<view class="budget-line">
					<text class="budget-big">¥{{ fmtMoney(budgetLeft) }}</text>
					<text class="budget-state" :class="budgetLeft < 0 ? 'warn-text' : ''">
						{{ budgetLeft < 0 ? '已超支' : '剩余可用' }}
					</text>
				</view>
				<view class="budget-track">
					<view class="budget-fill" :class="budgetLeft < 0 ? 'budget-over' : ''" :style="'width:' + budgetPercent + '%'"></view>
				</view>
				<text class="budget-detail">预算 ¥{{ fmtMoney(budget) }} · 已用 ¥{{ fmtMoney(stat.expense) }}（{{ budgetPercent }}%）</text>
			</template>
			<template v-else>
				<text class="budget-empty">还没设置本月预算，点右上角「设置」开始规划支出吧</text>
			</template>
		</view>

		<!-- 资产管家 -->
		<view class="card">
			<view class="card-head">
				<text class="card-title">资产管家</text>
				<text class="card-action">管理 ›</text>
			</view>
			<view class="asset-box" @click="goAssets">
				<view class="asset-left">
					<text class="asset-total-label">净资产合计</text>
					<text class="asset-total">¥{{ fmtMoney(assetSum) }}</text>
					<text class="asset-count">共 {{ assets.length }} 个账户</text>
				</view>
				<view class="asset-emoji">
					<text class="asset-emoji-text">🏦</text>
				</view>
			</view>
		</view>

		<!-- 常用功能 -->
		<view class="card">
			<text class="card-title">常用功能</text>
			<view class="tool-grid">
				<view class="tool-cell" @click="goTool('/pages/tools/mortgage')">
					<view class="tool-icon-box" style="background-color: #E3F2FD">
						<text class="tool-icon">🏠</text>
					</view>
					<text class="tool-name">房贷计算器</text>
				</view>
				<view class="tool-cell" @click="goTool('/pages/tools/exchange')">
					<view class="tool-icon-box" style="background-color: #E0F7F5">
						<text class="tool-icon">💱</text>
					</view>
					<text class="tool-name">汇率转换</text>
				</view>
				<view class="tool-cell" @click="goTool('/pages/tools/invoice')">
					<view class="tool-icon-box" style="background-color: #FFF3E0">
						<text class="tool-icon">🧾</text>
					</view>
					<text class="tool-name">发票助手</text>
				</view>
				<view class="tool-cell" @click="goAssets">
					<view class="tool-icon-box" style="background-color: #EDE7F6">
						<text class="tool-icon">🏦</text>
					</view>
					<text class="tool-name">资产管家</text>
				</view>
			</view>
		</view>

		<view class="bottom-space"></view>
	</scroll-view>
</template>

<script>
	import { loadBills, monthStat, getBudget, setBudget, loadAssets, assetTotal, MonthStat } from '@/utils/data.uts'
	import { fmtMoney, todayMonth, prevMonth, nextMonth } from '@/utils/date.uts'

	export default {
		data() {
			return {
				month: todayMonth(),
				stat: { income: 0, expense: 0, balance: 0 } as MonthStat,
				budget: 0,
				assets: [] as Array<any>,
				assetSum: 0
			}
		},
		computed: {
			monthLabel(): string {
				return this.month.replace('-', '年') + '月'
			},
			budgetLeft(): number {
				return this.budget - this.stat.expense
			},
			budgetPercent(): number {
				if (this.budget <= 0) return 0
				const p = Math.round(this.stat.expense / this.budget * 100)
				if (p > 100) return 100
				return p
			}
		},
		onShow() {
			this.refresh()
		},
		methods: {
			refresh() {
				const bills = loadBills()
				this.stat = monthStat(bills, this.month)
				this.budget = getBudget(this.month)
				this.assets = loadAssets()
				this.assetSum = assetTotal(this.assets)
			},
			editBudget() {
				uni.showModal({
					title: '设置预算',
					editable: true,
					placeholderContent: '输入本月预算金额',
					content: this.budget > 0 ? `${this.budget}` : '',
					success: (res) => {
						if (res.confirm) {
							const v = parseFloat(res.content as string)
							if (isNaN(v) || v < 0) {
								uni.showToast({ title: '请输入有效金额', icon: 'none' })
								return
							}
							setBudget(this.month, v)
							this.refresh()
							uni.showToast({ title: '已保存', icon: 'success' })
						}
					}
				})
			},
			goAssets() {
				uni.navigateTo({ url: '/pages/assets/assets' })
			},
			goTool(url: string) {
				uni.navigateTo({ url: url })
			},
			fmtMoney(n: number): string {
				return fmtMoney(n)
			}
		}
	}
</script>

<style>
	.page {
		flex: 1;
		background-color: #F7F8FC;
	}

	/* 月度结余卡 */
	.hero-card {
		margin: 24rpx;
