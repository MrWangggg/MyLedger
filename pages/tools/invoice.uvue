	.page {
		flex: 1;
		background-color: #F7F8FC;
	}
	.body {
		flex: 1;
	}

	.card {
		margin: 24rpx;
		background-color: #FFFFFF;
		border-radius: 20rpx;
		padding: 30rpx;
	}
