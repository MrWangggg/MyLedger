		font-size: 28rpx;
		font-weight: bold;
		color: #92600A;
	}
	.tip-text {
		margin-top: 10rpx;
		font-size: 24rpx;
		color: #B08968;
		line-height: 38rpx;
	}

	.empty {
		margin-top: 140rpx;
		align-items: center;
	}
	.empty-icon {
		font-size: 90rpx;
	}
	.empty-text {
		margin-top: 20rpx;
		font-size: 30rpx;
		color: #4B5563;
	}
	.empty-tip {
		margin-top: 10rpx;
		font-size: 24rpx;
		color: #9CA3AF;
	}

	.inv-list {
		margin: 8rpx 24rpx 0 24rpx;
		background-color: #FFFFFF;
		border-radius: 20rpx;
		padding: 0 24rpx;
	}
	.inv-item {
		flex-direction: row;
		align-items: center;
		padding: 24rpx 0;
		border-bottom-width: 1px;
		border-bottom-style: solid;
		border-bottom-color: #F3F4F6;
	}
	.inv-main {
		flex: 1;
		flex-direction: column;
	}
	.inv-title {
		font-size: 30rpx;
		font-weight: bold;
		color: #1F2937;
	}
	.inv-tax {
		margin-top: 8rpx;
		font-size: 24rpx;
		color: #6B7280;
	}
	.inv-copy {
		margin-top: 8rpx;
		font-size: 20rpx;
		color: #2F6BFF;
	}
	.inv-del {
		width: 56rpx;
		height: 56rpx;
		line-height: 56rpx;
		text-align: center;
		font-size: 24rpx;
		color: #EF4444;
		background-color: #FEF2F2;
		border-radius: 12rpx;
	}

	.body-space {
		height: 40rpx;
	}

	.footer {
		padding: 20rpx 24rpx 40rpx 24rpx;
		background-color: #FFFFFF;
	}
	.add-btn {
		height: 92rpx;
		background-color: #2F6BFF;
		border-radius: 46rpx;
		justify-content: center;
		align-items: center;
	}
	.add-btn-text {
		font-size: 32rpx;
		font-weight: bold;
		color: #FFFFFF;
	}
</style>
