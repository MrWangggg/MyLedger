		font-weight: bold;
		color: #FFFFFF;
	}
	.income-text {
		color: #7BE8A8;
	}
	.budget-box {
		margin-top: 26rpx;
	}
	.budget-head {
		flex-direction: row;
		justify-content: space-between;
	}
	.budget-text {
		font-size: 22rpx;
		color: rgba(255, 255, 255, 0.85);
	}
	.warn-text {
		color: #FFD180;
	}
	.budget-track {
		margin-top: 10rpx;
		height: 12rpx;
		background-color: rgba(255, 255, 255, 0.25);
		border-radius: 6rpx;
		overflow: hidden;
	}
	.budget-fill {
		height: 12rpx;
		background-color: #7BE8A8;
		border-radius: 6rpx;
	}
	.budget-over {
		background-color: #FFB74D;
	}

	/* 空状态 */
	.empty {
		margin-top: 160rpx;
		align-items: center;
	}
	.empty-icon {
		font-size: 90rpx;
	}
	.empty-text {
