	/* 日分组 */
	.day-group {
		margin: 20rpx 24rpx 0 24rpx;
		background-color: #FFFFFF;
		border-radius: 20rpx;
		padding: 0 24rpx;
	}
	.day-head {
		flex-direction: row;
		justify-content: space-between;
		align-items: center;
		height: 76rpx;
		border-bottom-width: 1px;
		border-bottom-style: solid;
		border-bottom-color: #F3F4F6;
	}
	.day-label {
		font-size: 26rpx;
		font-weight: bold;
		color: #374151;
	}
	.day-sum {
		flex-direction: row;
	}
	.day-out {
		font-size: 22rpx;
		color: #9CA3AF;
		margin-right: 20rpx;
	}
	.day-in {
		font-size: 22rpx;
		color: #34C77B;
	}

	/* 账单项 */
	.bill-item {
		flex-direction: row;
		align-items: center;
		padding: 20rpx 0;
	}
	.bill-icon-box {
		width: 76rpx;
