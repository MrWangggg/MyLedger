		flex: 1;
		background-color: #F7F8FC;
	}

	/* 月份切换 */
	.month-bar {
		flex-direction: row;
		align-items: center;
		justify-content: center;
		padding: 12rpx 30rpx;
	}
	.month-arrow {
		width: 64rpx;
		height: 64rpx;
		justify-content: center;
		align-items: center;
	}
	.arrow-text {
		font-size: 44rpx;
		color: #6B7280;
	}
	.month-title-box {
		padding: 8rpx 24rpx;
		background-color: #FFFFFF;
		border-radius: 32rpx;
	}
	.month-title {
		font-size: 30rpx;
		font-weight: bold;
		color: #1F2937;
	}

	/* 收支汇总卡 */
	.sum-card {
		margin: 8rpx 24rpx 0 24rpx;
		padding: 30rpx;
		background-color: #2F6BFF;
		border-radius: 24rpx;
	}
	.sum-row {
		flex-direction: row;
	}
	.sum-item {
		flex: 1;
		flex-direction: column;
		align-items: center;
	}
	.sum-label {
		font-size: 22rpx;
		color: rgba(255, 255, 255, 0.75);
	}
	.sum-value {
		margin-top: 8rpx;
