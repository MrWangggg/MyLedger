<template>
	<scroll-view class="page" scroll-y>
		<!-- 月份切换 -->
		<view class="month-bar">
			<view class="month-arrow" @click="goPrevMonth">
				<text class="arrow-text">‹</text>
			</view>
			<view class="month-title-box">
				<picker mode="date" fields="month" :value="month" @change="onMonthPick">
					<text class="month-title">{{ monthLabel }}</text>
				</picker>
			</view>
			<view class="month-arrow" @click="goNextMonth">
				<text class="arrow-text">›</text>
			</view>
		</view>

		<!-- 收支汇总卡 -->
		<view class="sum-card">
			<view class="sum-row">
				<view class="sum-item">
					<text class="sum-label">本月收入</text>
					<text class="sum-value income-text">+{{ fmtMoney(stat.income) }}</text>
				</view>
				<view class="sum-item">
					<text class="sum-label">本月支出</text>
					<text class="sum-value">-{{ fmtMoney(stat.expense) }}</text>
				</view>
				<view class="sum-item">
					<text class="sum-label">结余</text>
					<text class="sum-value">{{ fmtMoney(stat.balance) }}</text>
				</view>
			</view>
			<!-- 预算进度 -->
			<view class="budget-box" v-if="budget > 0">
				<view class="budget-head">
					<text class="budget-text">预算 {{ fmtMoney(budget) }}</text>
					<text class="budget-text" :class="budgetLeft < 0 ? 'warn-text' : ''">剩余 {{ fmtMoney(budgetLeft) }}</text>
				</view>
				<view class="budget-track">
					<view class="budget-fill" :class="budgetLeft < 0 ? 'budget-over' : ''" :style="'width:' + budgetPercent + '%'"></view>
				</view>
			</view>
		</view>

		<!-- 空状态 -->
		<view class="empty" v-if="groups.length == 0">
			<text class="empty-icon">📒</text>
			<text class="empty-text">本月还没有账单</text>
			<text class="empty-tip">点击底部大加号记一笔吧</text>
		</view>

		<!-- 按日分组列表 -->
		<view class="day-group" v-for="(g, gi) in groups" :key="g.date">
			<view class="day-head">
				<text class="day-label">{{ dayTitle(gi) }}</text>
				<view class="day-sum">
					<text class="day-out" v-if="g.expense > 0">支出 {{ fmtMoney(g.expense) }}</text>
					<text class="day-in" v-if="g.income > 0">收入 {{ fmtMoney(g.income) }}</text>
				</view>
			</view>
			<view class="bill-item" v-for="(b, bi) in g.items" :key="b.id">
				<view class="bill-icon-box" :style="'background-color:' + catColor(b.catId) + '22'">
					<text class="bill-icon">{{ catIcon(b.catId) }}</text>
				</view>
				<view class="bill-info">
					<text class="bill-cat">{{ catName(b.catId) }}</text>
					<text class="bill-note" v-if="b.note.length > 0">{{ b.note }}</text>
				</view>
				<text class="bill-amount" :class="b.type == 1 ? 'income-text' : ''">
					{{ b.type == 1 ? '+' : '-' }}{{ fmtMoney(b.amount) }}
				</text>
				<text class="bill-del" @click="confirmRemove(b.id)">删</text>
			</view>
		</view>

		<view class="bottom-space"></view>
	</scroll-view>
</template>

<script>
	import { loadBills, monthStat, groupByDay, removeBill, getBudget, MonthStat } from '@/utils/data.uts'
	import { findCat } from '@/utils/cats.uts'
	import { fmtMoney, todayMonth, prevMonth, nextMonth, pad2, dayLabel } from '@/utils/date.uts'

	type GroupItem = {
		date: string
		label: string
		income: number
		expense: number
		items: Array<any>
	}

	export default {
		data() {
			return {
				month: todayMonth(),
				groups: [] as Array<GroupItem>,
				stat: { income: 0, expense: 0, balance: 0 } as MonthStat,
				budget: 0
			}
		},
		computed: {
			monthLabel(): string {
				return this.month.replace('-', '年') + '月'
			},
			budgetLeft(): number {
				return this.budget - this.stat.expense
			},
			budgetPercent(): number {
				if (this.budget <= 0) return 0
				const p = Math.round(this.stat.expense / this.budget * 100)
				if (p > 100) return 100
				return p
			}
		},
		onShow() {
			this.refresh()
		},
		methods: {
			refresh() {
				const bills = loadBills()
				this.stat = monthStat(bills, this.month)
				this.budget = getBudget(this.month)
				const gs = groupByDay(bills, this.month)
				const items: Array<GroupItem> = []
				for (let i = 0; i < gs.length; i++) {
					const g = gs[i]
					const arr: Array<any> = []
					for (let j = 0; j < g.items.length; j++) {
						arr.push({
							id: g.items[j].id,
							type: g.items[j].type,
							catId: g.items[j].catId,
							amount: g.items[j].amount,
							note: g.items[j].note
						})
					}
					items.push({
						date: g.date,
						label: g.label,
						income: g.income,
						expense: g.expense,
						items: arr
					})
				}
				this.groups = items
			},
			goPrevMonth() {
				this.month = prevMonth(this.month)
				this.refresh()
			},
			goNextMonth() {
				this.month = nextMonth(this.month)
				this.refresh()
			},
			onMonthPick(e: UniPickerChangeEvent) {
				const v = e.detail.value as string
				if (v.length >= 7) {
					this.month = v.substring(0, 7)
					this.refresh()
				}
			},
			dayTitle(gi: number): string {
				const g = this.groups[gi]
				return dayLabel(g.date)
			},
			catName(id: string): string {
				return findCat(id).name
			},
			catIcon(id: string): string {
				return findCat(id).icon
			},
			catColor(id: string): string {
				return findCat(id).color
			},
			fmtMoney(n: number): string {
				return fmtMoney(n)
			},
			confirmRemove(id: string) {
				uni.showModal({
					title: '删除账单',
					content: '确定删除这笔账单吗？',
					success: (res) => {
						if (res.confirm) {
							removeBill(id)
							this.refresh()
							uni.showToast({ title: '已删除', icon: 'success' })
						}
					}
				})
			}
		}
	}
</script>

<style>
