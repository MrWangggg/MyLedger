	}

	/* 通用卡片 */
	.card {
		margin: 24rpx;
		background-color: #FFFFFF;
		border-radius: 20rpx;
		padding: 30rpx;
	}
	.card-title {
		font-size: 30rpx;
		font-weight: bold;
		color: #1F2937;
	}

	/* 统计宫格 */
	.stat-grid {
		flex-direction: row;
		flex-wrap: wrap;
		margin-top: 10rpx;
	}
	.stat-cell {
		width: 50%;
		align-items: center;
		margin-top: 26rpx;
	}
	.stat-num {
		font-size: 34rpx;
		font-weight: bold;
		color: #1F2937;
	}
	.stat-label {
		margin-top: 8rpx;
		font-size: 22rpx;
		color: #9CA3AF;
	}

	/* 设置项 */
	.cell {
		flex-direction: row;
		justify-content: space-between;
		align-items: center;
		height: 92rpx;
	}
	.cell-left {
		flex-direction: row;
		align-items: center;
	}
	.cell-icon {
		font-size: 32rpx;
		margin-right: 16rpx;
	}
	.cell-name {
		font-size: 28rpx;
		color: #374151;
	}
	.cell-arrow {
		font-size: 32rpx;
		color: #C0C8D4;
	}

	.about-text {
		margin-top: 16rpx;
