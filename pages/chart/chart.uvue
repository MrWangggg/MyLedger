<template>
	<scroll-view class="page" scroll-y>
		<!-- 月份切换 -->
		<view class="month-bar">
			<view class="month-arrow" @click="goPrevMonth">
				<text class="arrow-text">‹</text>
			</view>
			<text class="month-title">{{ monthLabel }}</text>
			<view class="month-arrow" @click="goNextMonth">
				<text class="arrow-text">›</text>
			</view>
		</view>

		<!-- 收支切换 -->
		<view class="seg-box">
			<text class="seg-item" :class="type == 0 ? 'seg-active' : ''" @click="switchType(0)">支出</text>
			<text class="seg-item" :class="type == 1 ? 'seg-active' : ''" @click="switchType(1)">收入</text>
		</view>

		<!-- 空状态 -->
		<view class="empty" v-if="ranks.length == 0">
			<text class="empty-icon">📊</text>
			<text class="empty-text">本月暂无{{ type == 0 ? '支出' : '收入' }}数据</text>
		</view>

		<!-- 分类排行 -->
		<view class="card" v-if="ranks.length > 0">
			<text class="card-title">分类排行</text>
			<view class="rank-item" v-for="(r, i) in ranks" :key="r.catId">
				<text class="rank-no" :class="i < 3 ? 'rank-top' : ''">{{ i + 1 }}</text>
				<view class="rank-icon-box" :style="'background-color:' + r.color + '22'">
					<text class="rank-icon">{{ r.icon }}</text>
				</view>
				<view class="rank-info">
					<view class="rank-line1">
						<text class="rank-name">{{ r.name }}</text>
						<text class="rank-percent">{{ r.percent }}%</text>
					</view>
					<view class="rank-track">
						<view class="rank-fill" :style="'width:' + barWidth(i) + '%;background-color:' + r.color"></view>
					</view>
				</view>
				<text class="rank-amount">{{ fmtMoney(r.amount) }}</text>
			</view>
		</view>

		<!-- 每日支出趋势 -->
		<view class="card" v-if="type == 0 && series.length > 0">
			<text class="card-title">每日支出趋势</text>
			<view class="trend-box">
				<view class="trend-bar-box" v-for="(v, i) in series" :key="i">
					<view class="trend-bar" :style="'height:' + barHeight(v) + 'rpx'"></view>
				</view>
			</view>
			<view class="trend-x">
				<text class="trend-x-text">1日</text>
				<text class="trend-x-text">15日</text>
				<text class="trend-x-text">{{ days }}日</text>
			</view>
			<text class="trend-sum">月支出合计 ¥{{ fmtMoney(totalExpense) }}</text>
		</view>

		<view class="bottom-space"></view>
	</scroll-view>
</template>

<script>
	import { loadBills, catRank, dailySeries, monthStat } from '@/utils/data.uts'
	import { findCat } from '@/utils/cats.uts'
	import { fmtMoney, todayMonth, prevMonth, nextMonth, daysInMonth } from '@/utils/date.uts'

	type RankItem = {
		catId: string
		name: string
		icon: string
		color: string
		amount: number
		percent: number
	}

	export default {
		data() {
			return {
				month: todayMonth(),
				type: 0,
				ranks: [] as Array<RankItem>,
				series: [] as Array<number>,
				days: 30,
				totalExpense: 0
			}
		},
		computed: {
			monthLabel(): string {
				return this.month.replace('-', '年') + '月'
			}
		},
		onShow() {
			this.refresh()
		},
		methods: {
			refresh() {
				const bills = loadBills()
				this.days = daysInMonth(this.month)
				// 分类排行
				const rs = catRank(bills, this.month, this.type)
				const items: Array<RankItem> = []
				for (let i = 0; i < rs.length; i++) {
					const cat = findCat(rs[i].catId)
					items.push({
						catId: rs[i].catId,
						name: cat.name,
						icon: cat.icon,
						color: cat.color,
						amount: rs[i].amount,
						percent: rs[i].percent
					})
				}
				this.ranks = items
				// 每日趋势
				if (this.type == 0) {
					this.series = dailySeries(bills, this.month, this.days)
					this.totalExpense = monthStat(bills, this.month).expense
				}
			},
			switchType(t: number) {
				this.type = t
				this.refresh()
			},
			goPrevMonth() {
				this.month = prevMonth(this.month)
				this.refresh()
			},
			goNextMonth() {
				this.month = nextMonth(this.month)
				this.refresh()
			},
			barWidth(i: number): number {
				if (this.ranks.length == 0) return 0
				const max = this.ranks[0].amount
				if (max <= 0) return 0
				const w = Math.round(this.ranks[i].amount / max * 100)
				if (w < 4) return 4
				return w
			},
			barHeight(v: number): number {
				let max = 0
				for (let i = 0; i < this.series.length; i++) {
					if (this.series[i] > max) max = this.series[i]
				}
				if (max <= 0 || v <= 0) return 4
				const h = Math.round(v / max * 180)
				if (h < 4) return 4
				return h
			},
			fmtMoney(n: number): string {
				return fmtMoney(n)
			}
		}
	}
</script>

<style>
	.page {
		flex: 1;
		background-color: #F7F8FC;
	}

	.month-bar {
		flex-direction: row;
		align-items: center;
		justify-content: center;
		padding: 12rpx 30rpx;
	}
	.month-arrow {
		width: 64rpx;
		height: 64rpx;
		justify-content: center;
		align-items: center;
	}
	.arrow-text {
		font-size: 44rpx;
		color: #6B7280;
	}
	.month-title {
		font-size: 30rpx;
		font-weight: bold;
		color: #1F2937;
	}

	.seg-box {
		flex-direction: row;
		align-self: center;
		margin-top: 6rpx;
		background-color: #ECEFF5;
		border-radius: 30rpx;
		padding: 6rpx;
	}
	.seg-item {
		width: 140rpx;
		height: 52rpx;
		line-height: 52rpx;
		text-align: center;
		font-size: 26rpx;
		color: #6B7280;
		border-radius: 26rpx;
	}
	.seg-active {
		background-color: #FFFFFF;
		color: #2F6BFF;
		font-weight: bold;
	}

	.empty {
		margin-top: 160rpx;
		align-items: center;
	}
	.empty-icon {
		font-size: 90rpx;
	}
	.empty-text {
		margin-top: 20rpx;
		font-size: 28rpx;
		color: #6B7280;
	}

	.card {
		margin: 24rpx;
		background-color: #FFFFFF;
		border-radius: 20rpx;
		padding: 30rpx;
	}
	.card-title {
		font-size: 30rpx;
		font-weight: bold;
		color: #1F2937;
	}

	/* 分类排行 */
	.rank-item {
		flex-direction: row;
		align-items: center;
		margin-top: 28rpx;
	}
	.rank-no {
		width: 44rpx;
		font-size: 26rpx;
		color: #9CA3AF;
		text-align: center;
	}
	.rank-top {
		color: #FF9800;
		font-weight: bold;
	}
	.rank-icon-box {
		width: 68rpx;
		height: 68rpx;
		border-radius: 34rpx;
		justify-content: center;
		align-items: center;
	}
	.rank-icon {
		font-size: 32rpx;
	}
	.rank-info {
		flex: 1;
		margin-left: 16rpx;
		margin-right: 16rpx;
	}
	.rank-line1 {
		flex-direction: row;
		justify-content: space-between;
	}
	.rank-name {
		font-size: 26rpx;
		color: #374151;
	}
	.rank-percent {
		font-size: 22rpx;
		color: #9CA3AF;
	}
	.rank-track {
		margin-top: 10rpx;
		height: 14rpx;
		background-color: #F3F4F6;
		border-radius: 7rpx;
		overflow: hidden;
	}
	.rank-fill {
		height: 14rpx;
		border-radius: 7rpx;
	}
	.rank-amount {
		width: 170rpx;
		text-align: right;
		font-size: 26rpx;
		font-weight: bold;
		color: #1F2937;
	}

	/* 每日趋势 */
	.trend-box {
		flex-direction: row;
		align-items: flex-end;
		height: 200rpx;
		margin-top: 30rpx;
	}
	.trend-bar-box {
		flex: 1;
		height: 200rpx;
		justify-content: flex-end;
		align-items: center;
	}
	.trend-bar {
		width: 60%;
		background-color: #5B8DFF;
		border-top-left-radius: 6rpx;
		border-top-right-radius: 6rpx;
	}
	.trend-x {
		flex-direction: row;
		justify-content: space-between;
		margin-top: 12rpx;
	}
	.trend-x-text {
		font-size: 20rpx;
		color: #9CA3AF;
	}
	.trend-sum {
		margin-top: 20rpx;
		font-size: 24rpx;
		color: #6B7280;
	}

	.bottom-space {
		height: 40rpx;
	}
</style>
